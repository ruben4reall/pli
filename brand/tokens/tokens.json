{
  "$description": "Pli brand tokens, direction A \"Glass\". Source of truth for tokens.css (node brand/scripts/tokens/build.mjs) and for the app's Packages/PliKit/Sources/PliUI/Design/Theme.swift, which ThemeTests checks against this file. Format: Design Tokens Community Group ($value, $type, $description).",
  "color": {
    "core": {
      "night": { "$type": "color", "$value": "#0A0C10", "$description": "Dark backgrounds, the black of the fold" },
      "slate": { "$type": "color", "$value": "#161A22", "$description": "Dark surfaces" },
      "ice": { "$type": "color", "$value": "#EEF2F6", "$description": "Light surfaces, text on dark" },
      "mist": { "$type": "color", "$value": "#8A94A3", "$description": "Secondary text on dark" },
      "glacier": { "$type": "color", "$value": "#7CCBFF", "$description": "The single accent in dark appearance" },
      "deep-glacier": { "$type": "color", "$value": "#0B6FB0", "$description": "The accent in light appearance: links and buttons" }
    },
    "light": {
      "white": { "$type": "color", "$value": "#FFFFFF", "$description": "Page background" },
      "paper": { "$type": "color", "$value": "#F5F5F7", "$description": "Alternating sections, cards" },
      "ink": { "$type": "color", "$value": "#1D1D1F", "$description": "Primary text" },
      "graphite": { "$type": "color", "$value": "#6E6E73", "$description": "Secondary text" },
      "hairline": { "$type": "color", "$value": "#D2D2D7", "$description": "Separators, outlines; never text" }
    }
  },
  "gradient": {
    "iridescent": {
      "$type": "gradient",
      "$value": [
        { "color": "#A6F0FF", "position": 0 },
        { "color": "#C8B8FF", "position": 0.5 },
        { "color": "#FFD3B0", "position": 1 }
      ],
      "$description": "Icon rim, website hero and key moments only, never for text; the stops run left to right"
    }
  },
  "role": {
    "$description": "What each surface uses. Light is the default for the website and brand materials; the app follows the system appearance.",
    "light": {
      "background": { "$type": "color", "$value": "{color.light.white}" },
      "surface": { "$type": "color", "$value": "{color.light.paper}" },
      "text": { "$type": "color", "$value": "{color.light.ink}" },
      "text-secondary": { "$type": "color", "$value": "{color.light.graphite}" },
      "separator": { "$type": "color", "$value": "{color.light.hairline}" },
      "accent": { "$type": "color", "$value": "{color.core.deep-glacier}" }
    },
    "dark": {
      "background": { "$type": "color", "$value": "{color.core.night}" },
      "surface": { "$type": "color", "$value": "{color.core.slate}" },
      "text": { "$type": "color", "$value": "{color.core.ice}" },
      "text-secondary": { "$type": "color", "$value": "{color.core.mist}" },
      "separator": { "$type": "color", "$value": "#EEF2F624", "$description": "Ice at 14% opacity: quiet, and visible on Night and on Slate" },
      "accent": { "$type": "color", "$value": "{color.core.glacier}" }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["-apple-system", "BlinkMacSystemFont", "system-ui", "Inter", "sans-serif"],
        "$description": "SF Pro through the system stack; SF Pro is never embedded or shipped. Inter (OFL) is the only webfont allowed, as the fallback."
      }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    }
  },
  "type": {
    "$description": "Size and line height in px; tracking in em, after SF Pro's two optical cuts: the text sizes (under 20 px) and the display sizes (20 px and up) each track tighter as they grow, and the display cut starts more open than the text cut ends.",
    "display-1": { "$type": "typography", "$value": { "fontSize": "64px", "lineHeight": "68px", "fontWeight": 600, "letterSpacing": "-0.009em" } },
    "display-2": { "$type": "typography", "$value": { "fontSize": "56px", "lineHeight": "60px", "fontWeight": 600, "letterSpacing": "-0.005em" } },
    "display-3": { "$type": "typography", "$value": { "fontSize": "48px", "lineHeight": "52px", "fontWeight": 600, "letterSpacing": "-0.003em" } },
    "title-1": { "$type": "typography", "$value": { "fontSize": "32px", "lineHeight": "36px", "fontWeight": 600, "letterSpacing": "0.004em" } },
    "title-2": { "$type": "typography", "$value": { "fontSize": "28px", "lineHeight": "32px", "fontWeight": 600, "letterSpacing": "0.007em" } },
    "title-3": { "$type": "typography", "$value": { "fontSize": "22px", "lineHeight": "28px", "fontWeight": 600, "letterSpacing": "0.01em" } },
    "body-1": { "$type": "typography", "$value": { "fontSize": "17px", "lineHeight": "25px", "fontWeight": 400, "letterSpacing": "-0.022em" } },
    "body-2": { "$type": "typography", "$value": { "fontSize": "15px", "lineHeight": "22px", "fontWeight": 400, "letterSpacing": "-0.018em" } },
    "caption": { "$type": "typography", "$value": { "fontSize": "13px", "lineHeight": "18px", "fontWeight": 400, "letterSpacing": "-0.012em" } }
  },
  "radius": {
    "s": { "$type": "dimension", "$value": "8px", "$description": "Buttons, small controls" },
    "m": { "$type": "dimension", "$value": "12px", "$description": "Inputs, thumbnails" },
    "l": { "$type": "dimension", "$value": "20px", "$description": "Cards, previews" },
    "xl": { "$type": "dimension", "$value": "28px", "$description": "Large panels, hero frames" }
  },
  "space": {
    "$description": "4-point scale; the key is the multiple of 4.",
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "20": { "$type": "dimension", "$value": "80px" },
    "24": { "$type": "dimension", "$value": "96px" },
    "32": { "$type": "dimension", "$value": "128px" }
  },
  "motion": {
    "ease": {
      "fold": { "$type": "cubicBezier", "$value": [0.65, 0, 0.35, 1], "$description": "The fold: ease in and out (easeInOutCubic)" },
      "reveal": { "$type": "cubicBezier", "$value": [0.33, 1, 0.68, 1], "$description": "The reveal, the unfold: ease out (easeOutCubic)" }
    },
    "duration": {
      "fold": { "$type": "duration", "$value": "0.8s", "$description": "A timed fold (demo fold, animated lock)" },
      "reveal": { "$type": "duration", "$value": "0.9s", "$description": "A timed reveal (unlock reveal)" }
    }
  }
}
